# Copy to apps/web/.env to switch the web app from local-only to Appwrite.
# Leave unset (or absent) to run fully local (IndexedDB seed).
# NOTE: no API key here — the browser authenticates with an anonymous session.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=offlinear
